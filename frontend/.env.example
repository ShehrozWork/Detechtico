# Local development (direct to API on your machine)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel production:
# - Leave NEXT_PUBLIC_API_URL empty (or unset) so the browser calls the Vercel origin
# - Set API_PROXY_TARGET to the Paisol API, e.g. http://SERVER_PUBLIC_IP:8211
# API_PROXY_TARGET=http://x.x.x.x:8211
# NEXT_PUBLIC_API_URL=
