# Copy to backend/.env.production on the API host only — this file is not deployed from git.
# See DEPLOY.md for the full checklist.

ENVIRONMENT=production

ADMIN_DATABASE_URL=postgresql://detechtico:CHANGE_ME@db:5432/detechtico
DATABASE_URL=postgresql://detechtico_app:CHANGE_ME@db:5432/detechtico
APP_DB_ROLE=detechtico_app

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=detechtico
JWT_AUDIENCE=detechtico-web
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
ADMIN_ACCESS_TOKEN_MINUTES=5
ADMIN_REFRESH_TOKEN_DAYS=1
ADMIN_STEP_UP_MINUTES=10
ADMIN_MAX_REQUEUE=3
ADMIN_REVEAL_MINUTES=15
ADMIN_BOOTSTRAP_EMAILS=

CORS_ORIGINS=https://detechtico.vercel.app
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
TRUST_PROXY=true

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=26214400

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANALYSIS_REQUIRE_LLM=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_ESSENTIAL_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=

SMTP_HOST=mail.paisoltechnology.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Detechtico
SMTP_USE_TLS=true
