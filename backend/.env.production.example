# Copy to backend/.env.production on the server and fill secrets.
# Generate JWT_SECRET: python3 -c "import secrets; print(secrets.token_hex(32))"

ENVIRONMENT=production

ADMIN_DATABASE_URL=postgresql://detechtico:CHANGE_ME_ADMIN@db:5432/detechtico
DATABASE_URL=postgresql://detechtico_app:CHANGE_ME_APP@db:5432/detechtico
APP_DB_ROLE=detechtico_app

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=detechtico
JWT_AUDIENCE=detechtico-web
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7

# Your Vercel app origin(s), comma-separated — no trailing slash
CORS_ORIGINS=https://YOUR_APP.vercel.app

COOKIE_SECURE=true
# Same-origin via Vercel rewrite → lax is fine. Use none if browser calls API host directly.
COOKIE_SAMESITE=lax
TRUST_PROXY=true

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=26214400

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANALYSIS_REQUIRE_LLM=true
