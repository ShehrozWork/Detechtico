CORS_ORIGINS=https://detechtico.vercel.app
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
TRUST_PROXY=true

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=26214400

# REQUIRED for Claude analysis + /admin/ai-usage
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
