# Copy to backend/.env and fill in secrets.
# Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_hex(32))"

ENVIRONMENT=development
ADMIN_DATABASE_URL=postgresql://detechtico:detechtico_dev_only@127.0.0.1:5433/detechtico
DATABASE_URL=postgresql://detechtico_app:detechtico_app_dev_only@127.0.0.1:5433/detechtico
APP_DB_ROLE=detechtico_app
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=detechtico
JWT_AUDIENCE=detechtico-web
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=false
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANALYSIS_REQUIRE_LLM=false
