# Copy to backend/.env and fill in secrets.
# Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_hex(32))"

ENVIRONMENT=development
ADMIN_DATABASE_URL=postgresql://detechtico:detechtico_dev_only@127.0.0.1:5433/detechtico
DATABASE_URL=postgresql://detechtico_app:detechtico_app_dev_only@127.0.0.1:5433/detechtico
APP_DB_ROLE=detechtico_app
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=detechtico
JWT_AUDIENCE=detechtico-web
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
# Staff sessions are shorter than customer sessions
ADMIN_ACCESS_TOKEN_MINUTES=5
ADMIN_REFRESH_TOKEN_DAYS=1
ADMIN_STEP_UP_MINUTES=10
ADMIN_MAX_REQUEUE=3
ADMIN_REVEAL_MINUTES=15
# Comma-separated emails promoted to superadmin on next login if staff_role is empty
ADMIN_BOOTSTRAP_EMAILS=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=false
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANALYSIS_REQUIRE_LLM=false

# Stripe (test-mode keys locally). Create Essential + Professional products with
# monthly/annual Prices in the Stripe Dashboard, then paste Price IDs below.
# Webhook endpoint must hit the API host directly:
#   https://<api-host>/webhooks/stripe
# Local: stripe listen --forward-to localhost:8000/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_ESSENTIAL_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=

# SMTP (email change OTP + security alerts)
SMTP_HOST=mail.paisoltechnology.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Detechtico
SMTP_USE_TLS=true
